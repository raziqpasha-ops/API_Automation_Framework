<?xml version="1.0" encoding="UTF-8"?>
<!--
    testng.xml is the "suite plan" of the framework. It tells TestNG exactly which
    test classes to run and in what order. Maven's surefire plugin points to this
    file, so both a local "mvn test" and the Jenkins job execute the same suite.

    PARALLEL EXECUTION (the interview topic): the attribute
        parallel="tests"  means the three <test> blocks below each get their
                          own thread and run AT THE SAME TIME.
        thread-count="3"  is the maximum number of threads TestNG may use —
                          we have exactly 3 <test> blocks, so all three start
                          together and the whole suite finishes in roughly the
                          time of the SLOWEST block instead of the SUM of all.

    WHY THIS LEVEL IS SAFE: each <test> block is an independent scenario with
    its own bookings and its own token — they share no state. Inside the CRUD
    block the @Test methods stay SEQUENTIAL (ordered priorities sharing one
    booking), because running those against each other would corrupt their
    shared test subject. This is the professional choice: parallelize at the
    level where tests are independent, keep order where state is shared.

    WHY THE FRAMEWORK SURVIVES PARALLELISM: RestAssured's RequestSpecification
    is not thread-safe, so SpecFactory hands each thread its own spec via
    ThreadLocal. Log4j2 is thread-safe by design, and RetryAnalyzer instances
    are created fresh per test by TestNG — so logging, retry and HTTP all
    behave correctly when threads overlap.
-->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Restful-Booker API Suite" verbose="1"
       parallel="tests" thread-count="3">

    <!-- The listeners are wired HERE, not in the test classes. This keeps tests
         free of framework plumbing — they contain only scenario logic.
         TestListener : logging of start/pass/fail with full failure diagnosis.
         RetryListener: globally attaches RetryAnalyzer to EVERY test, so a flaky
                        failure is rerun automatically before being reported. -->
    <listeners>
        <listener class-name="com.booking.listeners.TestListener"/>
        <listener class-name="com.booking.listeners.RetryListener"/>
    </listeners>

    <test name="Auth, Negative and Health Checks">
        <classes>
            <class name="com.booking.tests.AuthAndNegativeTest"/>
        </classes>
    </test>

    <test name="Booking CRUD Component Tests">
        <classes>
            <class name="com.booking.tests.BookingCrudTest"/>
        </classes>
    </test>

    <test name="Booking End-to-End Flow">
        <classes>
            <class name="com.booking.tests.E2E_BookingFlowTest"/>
        </classes>
    </test>

</suite>
